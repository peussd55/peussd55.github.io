---
import Base from '../layouts/Base.astro';
import { getPosts, catsOf } from '../lib/posts';
import { headline, lead, glance, about, career, work, way, shooting, projects, papers } from '../data/profile';

const posts = await getPosts();
// "주요 업무"에는 대표 글(featured)만, 묶음마다 PER_GROUP편까지 보인다.
// 그 분류에 보이는 것보다 글이 더 있으면(대표 글이 아닌 글 포함) 글 탭의 그 분류로 보낸다.
const PER_GROUP = 3;
const featured = posts.filter((post) => post.data.featured);
// 묶음에 제목이 보이는 것은 대표 분류가 그 묶음인 글뿐이다(같은 제목이 두 묶음에 나오지 않게).
const inCat = (name: string) => featured.filter((post) => post.data.category === name);
// 편수와 "모두 보기"에는 덧붙는 분류로 들어온 글도 센다(글 탭에서는 그 분류로 나온다).
const countInCat = (name: string) => posts.filter((post) => catsOf(post).includes(name)).length;
const catHref = (name: string) => `/posts/?cat=${encodeURIComponent(name)}`;
const wayAll = inCat(way.category);
const wayPosts = wayAll.slice(0, PER_GROUP);
// 트러블슈팅 기록 — 종류가 troubleshooting 인 글을 최신순으로 SHOOTING_MAX편까지. SHOOTING_MIN편이 안 되면 칸을 내놓지 않는다.
const SHOOTING_MAX = 5;
const SHOOTING_MIN = 1;
const shootingAll = posts.filter((post) => post.data.kind === 'troubleshooting');
const shootingPosts = shootingAll.slice(0, SHOOTING_MAX);
---

<Base current="profile">
  <section class="hero wide">
    <h1>{headline}</h1>
    <p class="lead">{lead}</p>
  </section>

  <section class="glance wide" aria-labelledby="h-glance">
    <h2 class="section-title" id="h-glance">한눈에</h2>
    <div class="glance__grid">
      <div class="glance__col">
        <h3>경력</h3>
        <ul class="dated">
          {glance.career.map((item) => (
            <li>
              <span class="date">{item.date}</span>
              <span class="txt">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="glance__col">
        <h3>수상 · 자격</h3>
        <ul class="dated">
          {glance.awards.map((item) => (
            <li>
              <span class="date">{item.date}</span>
              <span class="txt">{item.text}</span>
              <span class="note">{item.note}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="glance__col">
        <h3>주요 업무</h3>
        <ul class="doing">
          {glance.doing.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wide" aria-labelledby="h-about">
    <h2 class="section-title" id="h-about">소개</h2>
    <div class="about">
      {about.map((line) => (
        <p>{line.map((seg) => (seg.hl ? <strong class="hl">{seg.t}</strong> : seg.t))}</p>
      ))}
    </div>
  </section>

  <section class="section wide" aria-labelledby="h-exp">
    <h2 class="section-title" id="h-exp">경력</h2>
    <ol class="timeline">
      {career.map((job) => (
        <li class="tl">
          <p class="tl__date">{job.date}</p>
          <span class="tl__rail" aria-hidden="true" />
          <div class="tl__body">
            <h3 class="tl__title">{job.title}</h3>
            <p class="tl__role">{job.role}</p>
            {job.topics.length > 0 && (
              <ul class="topics">
                {job.topics.map((topic) => (
                  <li><strong>{topic.k}</strong>{' '}{topic.v}</li>
                ))}
              </ul>
            )}
            {job.subs.map((sub) => (
              <div class="sub">
                <h4>{sub.title}</h4>
                <ul class="topics">
                  {sub.topics.map((topic) => (
                    <li><strong>{topic.k}</strong>{' '}{topic.v}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wide" aria-labelledby="h-work">
    <h2 class="section-title" id="h-work">주요 업무</h2>
    <div class="work-grid">
      {work.map((group) => {
        const all = inCat(group.name);
        const items = all.slice(0, PER_GROUP);
        return (
          <article class="work">
            <h3 class="work__name">{group.name}</h3>
            <p class="work__sum">{group.summary}</p>
            {items.length > 0 && (
              <ul class="work__posts">
                {items.map((post) => (
                  <li><a class="link" href={`/posts/${post.id}/`}>{post.data.title}</a></li>
                ))}
              </ul>
            )}
            {countInCat(group.name) > items.length && (
              <p class="work__more">
                <a href={catHref(group.name)}>이 분류의 글 모두 보기 ({countInCat(group.name)}편) →</a>
              </p>
            )}
          </article>
        );
      })}
      <article class="work work--way">
        <h3 class="work__name">{way.name}</h3>
        <p class="work__sum">{way.summary}</p>
        {wayPosts.length > 0 && (
          <ul class="work__posts">
            {wayPosts.map((post) => (
              <li><a class="link" href={`/posts/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        )}
        {countInCat(way.category) > wayPosts.length && (
          <p class="work__more">
            <a href={catHref(way.category)}>이 분류의 글 모두 보기 ({countInCat(way.category)}편) →</a>
          </p>
        )}
      </article>
      {shootingAll.length >= SHOOTING_MIN && (
        <article class="work work--way">
          <h3 class="work__name">{shooting.name}</h3>
          <p class="work__sum">{shooting.summary}</p>
          <ul class="work__posts">
            {shootingPosts.map((post) => (
              <li>
                <a class="link" href={`/posts/${post.id}/`}>{post.data.title}</a>
                <span class="work__cat">{post.data.category}</span>
              </li>
            ))}
          </ul>
          {shootingAll.length > shootingPosts.length && (
            <p class="work__more">
              <a href="/posts/?kind=troubleshooting">트러블슈팅 기록 모두 보기 ({shootingAll.length}편) →</a>
            </p>
          )}
        </article>
      )}
    </div>
  </section>

  <section class="section section--minor wide" aria-labelledby="h-etc">
    <h2 class="section-title" id="h-etc">그 밖에</h2>
    <div class="minor-grid">
      <div>
        <h3>이전 프로젝트</h3>
        <ul>
          {projects.map((item) => (
            <li>
              {item.href ? <a href={item.href} target="_blank" rel="noopener">{item.title}</a> : item.title}
              {item.note && <span class="note">{item.note}</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>논문 리뷰</h3>
        <ul class="two-col">
          {papers.map((item) => (
            <li><a href={item.href} target="_blank" rel="noopener">{item.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
