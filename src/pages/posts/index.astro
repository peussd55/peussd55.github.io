---
import Base from '../../layouts/Base.astro';
import { site, categories, kindLabels } from '../../data/site';
import { getPosts, isListVisible, formatDate, catsOf } from '../../lib/posts';

const posts = await getPosts();

// 글이 모이기 전에는 목록을 내놓지 않는다.
if (!isListVisible(posts.length)) {
  return Astro.redirect('/');
}

// 글의 종류: 대표 글(featured)은 긴 글, 머리말에 kind 를 적은 글은 그 종류. 종류 줄은 종류가 적힌 글이 있을 때만 내놓는다.
const kindOf = (post: (typeof posts)[number]) => post.data.kind ?? (post.data.featured ? 'long' : '');
// 종류 줄의 단추는 그 종류의 글이 한 편이라도 있을 때만 내놓는다(긴 글은 늘 내놓는다).
const kinds = [
  { id: 'long', label: '긴 글' },
  ...Object.entries(kindLabels)
    .filter(([id]) => posts.some((post) => post.data.kind === id))
    .map(([id, label]) => ({ id, label })),
];
const hasKinds = posts.some((post) => post.data.kind);
---

<Base title="글" current="posts">
  <div class="posts col">
    <h1 class="vh">글</h1>

    <div class="posts-bar">
      <div class="cats" aria-label="분류">
        <button type="button" data-cat="all" aria-pressed="true">전체</button>
        {categories.map((cat) => (
          <button type="button" data-cat={cat} aria-pressed="false">{cat}</button>
        ))}
      </div>
      <label class="search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.5" />
          <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <input id="post-search" type="search" aria-label="검색" />
      </label>
    </div>

    {hasKinds && (
      <div class="kinds" aria-label="글의 종류">
        <button type="button" data-kind="all" aria-pressed="true">전체</button>
        {kinds.map((kind) => (
          <button type="button" data-kind={kind.id} aria-pressed="false">{kind.label}</button>
        ))}
      </div>
    )}

    <ol class="post-list">
      {posts.map((post) => (
        <li data-cat={post.data.category} data-also={post.data.also} data-kind={kindOf(post)}>
          <a class="post-item" href={`/posts/${post.id}/`}>
            <p class="post-item__cat">
              {catsOf(post).join(' · ')}
              {post.data.kind && <span class="tag">{kindLabels[post.data.kind]}</span>}
            </p>
            <h2 class="post-item__title">{post.data.title}</h2>
            <p class="post-item__sum">{post.data.summary}</p>
            <p class="post-item__meta">{site.name} · {formatDate(post.data.date)}</p>
          </a>
        </li>
      ))}
    </ol>
    <p class="post-empty" hidden>조건에 맞는 글이 없어요.</p>
  </div>
</Base>

<script>
  // 분류 · 종류 · 검색어로 목록을 거른다.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.cats button'));
  const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.kinds button'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.post-list > li'));
  const search = document.querySelector<HTMLInputElement>('#post-search');
  const empty = document.querySelector<HTMLElement>('.post-empty');
  let cat = 'all';
  let kind = 'all';

  function apply() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      // 대표 분류나 덧붙는 분류 가운데 하나가 맞으면 그 분류의 글이다.
      const inCat = cat === 'all' || item.dataset.cat === cat || item.dataset.also === cat;
      const inKind = kind === 'all' || item.dataset.kind === kind;
      const inQuery = !query || (item.textContent ?? '').toLowerCase().includes(query);
      item.hidden = !(inCat && inKind && inQuery);
      if (!item.hidden) shown += 1;
    }
    // 분류와 종류를 겹쳐 고르거나 검색어가 안 맞아 남는 글이 없을 때.
    if (empty) empty.hidden = shown > 0;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      cat = button.dataset.cat ?? 'all';
      for (const other of buttons) other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
      apply();
    });
  }
  for (const button of kindButtons) {
    button.addEventListener('click', () => {
      kind = button.dataset.kind ?? 'all';
      for (const other of kindButtons) other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
      apply();
    });
  }
  search?.addEventListener('input', apply);

  // 주소에 ?cat=분류 나 ?kind=종류 가 있으면 그것이 눌린 채로 연다(프로필의 "모두 보기" 링크).
  const params = new URLSearchParams(location.search);
  buttons.find((button) => button.dataset.cat === params.get('cat'))?.click();
  kindButtons.find((button) => button.dataset.kind === params.get('kind'))?.click();
</script>
