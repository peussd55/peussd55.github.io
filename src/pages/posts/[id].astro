---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getPosts, isListVisible, formatDate, catsOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, listVisible: isListVisible(posts.length) },
  }));
}

const { post, listVisible } = Astro.props;
const { Content, headings } = await render(post);
// 차례에는 큰 소제목(##)만 넣는다.
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base title={post.data.title} description={post.data.summary} current="posts">
  <article class="post col">
    <header class="post-head">
      <p class="post-cat">
        {catsOf(post).join(' · ')}
        {post.data.kind === 'troubleshooting' && <span class="tag">트러블슈팅</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="post-sum">{post.data.summary}</p>
      <p class="post-meta">{site.name} · {formatDate(post.data.date)}</p>
    </header>

    <div class="post-body">
      <div class="prose">
        <Content />
      </div>

      {toc.length > 1 && (
        <aside class="toc" aria-labelledby="toc-label">
          <div class="toc__inner">
            <p class="toc__label" id="toc-label">이 글의 차례</p>
            <ol>
              {toc.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </div>
        </aside>
      )}
    </div>

    {post.data.role && <p class="post-role">역할 · {post.data.role}</p>}
  </article>

  <nav class="post-back col" aria-label="글 목록">
    {listVisible ? <a class="link" href="/posts/">목록으로</a> : <a class="link" href="/">프로필로</a>}
  </nav>
</Base>

<script>
  // 이 글의 차례: 화면 위쪽 40% 선을 지난 마지막 소제목을 표시한다. 맨 끝까지 내리면 마지막 소제목.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const heads = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((head): head is HTMLElement => head !== null);

  function update() {
    const line = Math.min(window.innerHeight * 0.4, 360);
    let index = 0;
    heads.forEach((head, i) => {
      if (head.getBoundingClientRect().top - line <= 0) index = i;
    });
    const doc = document.documentElement;
    const atEnd = window.innerHeight + window.scrollY >= doc.scrollHeight - 2;
    if (doc.scrollHeight > window.innerHeight + 2 && atEnd) index = heads.length - 1;
    links.forEach((link, i) => {
      link.classList.toggle('is-active', i === index);
      if (i === index) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  if (links.length > 0 && heads.length === links.length) {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }

  // 클립보드에 글을 넣는다. 클립보드 API가 막힌 곳(일부 앱 안 브라우저)에서는 임시 입력 칸을 골라 복사한다.
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  }

  // 코드 칸마다 복사 버튼을 붙인다. pre를 .code로 감싸고 그 위 한 줄에 버튼을 둔다.
  for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code';
    const bar = document.createElement('div');
    bar.className = 'code__bar';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code__copy';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');

    let timer = 0;
    button.addEventListener('click', async () => {
      const text = (pre.querySelector('code') ?? pre).innerText;
      button.textContent = (await copyText(text)) ? '복사됨' : '복사 안 됨';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = '복사';
      }, 1600);
    });

    pre.replaceWith(wrap);
    bar.append(button);
    wrap.append(bar, pre);
  }
</script>
